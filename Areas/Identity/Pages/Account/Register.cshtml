@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<h1>@ViewData["Title"]</h1>

<div class="column">
    <div class="col-md-4 columna-registro">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h2>Registrate al campus de Proyecto</h2>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

             <div class="form-floating mb-3">
                <input asp-for="Input.FirstName" class="form-control" placeholder="Ingrese su nombre."/>
                <label asp-for="Input.FirstName" class="form-label"></label>
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>

             <div class="form-floating mb-3">
                <input asp-for="Input.SecondName" class="form-control" placeholder="Ingrese su apellido."/>
                <label asp-for="Input.SecondName" class="form-label"></label>
                <span asp-validation-for="Input.SecondName" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.NumeroRegistro" class="form-control" placeholder="Ingrese su numero de registro."/>
                <label asp-for="Input.NumeroRegistro" class="form-label"></label>
                <span asp-validation-for="Input.SecondName" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password">Contraseña</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.ConfirmPassword">Confirme contraseña</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Registro</button>
        </form>
  
    </div>
    <div class="col-md-4 columna-registro">
        <p>
             <a asp-page="./login" asp-route-returnUrl="@Model.ReturnUrl">Ingreso al campus</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
