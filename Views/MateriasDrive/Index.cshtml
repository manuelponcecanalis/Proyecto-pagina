@model IEnumerable<Pagina_proyecto.Models.MateriasDrive>

@{
    ViewData["Title"] = "Index";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="box">
    <h1>Materias Drive</h1>
    <form asp-action="SincronizarArchivos" method="post" style="display:inline">
        @Html.AntiForgeryToken()
        <button style="display: flex !important; margin-bottom: 6px" type="submit" class="btn btn-warning"
                onclick="return confirm('¿Sincronizar cantidad de archivos de todas las materias?')">
             Sincronizar archivos
        </button>
    </form>
    <p>
        <a asp-action="Create" class="btn btn-primary">Crear Nueva Materia</a>
    </p>

    <!-- Selector de filtro -->
    <div class="mb-3">
        <label for="filtro" class="form-label">Filtrar materias:</label>
        <select id="filtro" class="form-select w-auto" onchange="filtrarMaterias()">
            <option value="Todas" selected="@(ViewData["Filtro"]?.ToString() == "Todas" ? "selected" : null)">Todas</option>
            <option value="Activas" selected="@(ViewData["Filtro"]?.ToString() == "Activas" ? "selected" : null)">Activas</option>
            <option value="Inactivas" selected="@(ViewData["Filtro"]?.ToString() == "Inactivas" ? "selected" : null)">Inactivas</option>
        </select>



    </div>

    <table class="table table-striped table-bordered tkendo">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Materia)</th>
                <th>@Html.DisplayNameFor(model => model.DescripcionContenido)</th>
                <th>@Html.DisplayNameFor(model => model.CantidadArchivos)</th>
                <th>@Html.DisplayNameFor(model => model.CantidadVisualizaciones)</th>
                <th>@Html.DisplayNameFor(model => model.LinkCarpeta)</th>
                <th>@Html.DisplayNameFor(model => model.FechaCreacion)</th>
                <th>@Html.DisplayNameFor(model => model.Activo)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="row-@item.Id">
                    <td>@Html.DisplayFor(m => item.Materia)</td>
                    <td>@Html.DisplayFor(m => item.DescripcionContenido)</td>
                    <td>@Html.DisplayFor(m => item.CantidadArchivos)</td>
                    <td>@Html.DisplayFor(m => item.CantidadVisualizaciones)</td>
                    <td><a href="@item.LinkCarpeta" target="_blank">@item.LinkCarpeta</a></td>
                    <td>@Html.DisplayFor(m => item.FechaCreacion)</td>
                    <td>@Html.DisplayFor(m => item.Activo)</td>
                    <td class="text-nowrap">
                        
                        <a href="@Url.Action("Edit", "MateriasDrive", new { id = item.Id })" class="btn btn-sm btn-info me-1">Editar</a>
                        <button type="button" onclick="deleteMateria(@item.Id)" class="btn btn-sm btn-danger">Eliminar</button>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        // Filtrar materias según dropdown
        function filtrarMaterias() {
            const filtro = document.getElementById('filtro').value;
            window.location.href = `/MateriasDrive?filtro=${filtro}`;
        }

        // Delete con fetch HTTP DELETE
        async function deleteMateria(id) {
            if (!confirm("¿Está seguro de eliminar esta materia?")) return;

            const response = await fetch(`/MateriasDrive/Delete/${id}`, {
                method: 'DELETE',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                }
            });

            if (response.ok) {
                alert("Materia eliminada correctamente");
                document.getElementById(`row-${id}`).remove();
            } else {
                alert("Error al eliminar la materia");
            }
        }
    </script>
}
