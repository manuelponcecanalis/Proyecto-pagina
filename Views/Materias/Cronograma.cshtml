@model List<Pagina_proyecto.Models.Entities.Materia>
@{
    ViewData["Title"] = "Malla Sistemas";

    var aprobadas = ViewBag.Aprobadas as List<int> ?? new();
    var carreras = ViewBag.Carreras as List<Pagina_proyecto.Models.Entities.Carrera> ?? new();
    var idCarreraActual = (ViewBag.IdCarrera as int?)?.ToString() ?? "";

    var nombresArea = new Dictionary<string, string>
    {
        { "1", "Contador" },
        { "2", "Administración" },
        { "3", "Economía" },
        { "4", "Sistemas" },
        { "5", "Actuario" },
        { "6", "Téc. Datos" }
    };

    var slugs = new Dictionary<string, string>
    {
        { "1", "contador" },
        { "2", "administracion" },
        { "3", "economia" },
        { "4", "sistemas" },
        { "5", "actuario" },
        { "6", "tec-datos" }
    };

    var nombreArea = nombresArea.TryGetValue(idCarreraActual, out var n) ? n : "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Cronograma.css" asp-append-version="true" />
}

<section class="cronograma-hero">
    <div class="container">
        <h1>🚀 Planes de estudio</h1>
        <p>Planes de estudio didacticos de todas las carreras</p>
    </div>
</section>

<!-- Selector de carrera (siempre visible) -->
<div class="seleccion-carrera-container">
    <h5>Seleccioná una carrera</h5>
    <div class="carreras-botones">
        @foreach (var c in carreras)
        {
            <button class="btn-carrera @(c.IdCarrera.ToString() == idCarreraActual ? "activa" : "")"
                    onclick="seleccionarCarrera('@c.IdCarrera', '@slugs.GetValueOrDefault(c.IdCarrera.ToString(), c.IdCarrera.ToString())')">
                @c.Nombre
            </button>
        }
    </div>
    <div id="mensajeCarrera" class="mt-1"></div>
</div>

@if (string.IsNullOrEmpty(idCarreraActual))
{
    <div class="instructivo">
        <p class="instructivo-titulo">Instrucciones</p>
        <p class="instructivo-subtitulo">Seleccioná tu carrera y completá las materias</p>
        <div class="instructivo-refs">
            <div class="instructivo-ref">
                <span class="ref-color" style="background:#198754;"></span>
                <span>Materia <strong>aprobada</strong></span>
            </div>
            <div class="instructivo-ref">
                <span class="ref-color" style="background:#1f6d8c;"></span>
                <span>Materia <strong>disponible</strong></span>
            </div>
            <div class="instructivo-ref">
                <span class="ref-color" style="background:#9e9e9e;"></span>
                <span>Pendiente de <strong>correlativas</strong></span>
            </div>
        </div>
        <div class="instructivo-footer">
            @if (User.Identity!.IsAuthenticated)
            {
                <p>Hacé click sobre una materia para guardar tu progreso</p>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Register">
                    Hacé un registro rápido y guardá tu progreso
                </a>
            }
        </div>
    </div>
}

<input type="hidden" id="idCarrera" value="@idCarreraActual" />

@if (!string.IsNullOrEmpty(idCarreraActual))
{
    <div class="malla-wrapper">
        <div class="malla">
            @if (idCarreraActual != "6")
            {
                <div class="header" style="grid-column: 1 / 3; grid-row: 1;">
                    CICLO GENERAL
                </div>
                <div class="header" style="grid-column: 3 / 5; grid-row: 1;">
                    CICLO PROFESIONAL
                </div>
            }

            @if (Model != null && Model.Any())
            {
                @for (int i = 0; i < Model.Count; i++)
                {
                    var m = Model[i];
                    var totalFilas = 6;
                    var col = (i / totalFilas) + 1;
                    var row = (i % totalFilas) + 2;
                    var aprobada = aprobadas.Contains(m.IdMateria);
                    var desbloqueada = m.Correlativas == null || !m.Correlativas.Any() ||
                    m.Correlativas.All(c =>
                    c.IdMateriaCorrelativa < 31
                    ? aprobadas.Count >= c.IdMateriaCorrelativa
                    : aprobadas.Contains(c.IdMateriaCorrelativa));
                    var css = aprobada ? "aprobada" : desbloqueada ? "disponible" : "bloqueada";

                    <div class="materia @css"
                         style="grid-column:@col; grid-row:@row;"
                         data-id="@m.IdMateria"
                         data-correlativas="@string.Join(",", m.Correlativas?.Select(c => c.IdMateriaCorrelativa) ?? Enumerable.Empty<int>())"
                         onclick="toggleMateria(this)">
                        <div class="area">@nombreArea</div>
                        <div class="codigo">@m.IdMateria</div>
                        <div class="horas">@(m.Horas.HasValue ? $"{m.Horas}VH" : "")</div>
                        <div class="nombre">
                            <p>@m.Nombre</p>
                            @if (m.Correlativas != null)
                            {
                                <div>
                                    @foreach (var c in m.Correlativas)
                                    {
                                        <div class="correlativa">
                                            @(c.IdMateriaCorrelativa < 31
                                                                    ? (c.MateriaCorrelativa?.Nombre ?? c.IdMateriaCorrelativa.ToString())
                                                                    : c.IdMateriaCorrelativa.ToString())
                    </div>
                                        }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="grid-column:1 / -1; margin-top:20px;">
                    No hay materias cargadas.
                </div>
            }
        </div>
    </div>
}

<!-- ============================
        SCRIPT
============================= -->
<script>
    function getIdCarrera() {
        return document.getElementById("idCarrera").value;
    }

    const aprobadas = new Set([
        @Html.Raw(string.Join(",", aprobadas))
    ]);

    async function toggleMateria(card) {
        const idMateria = card.dataset.id;
        const idCarrera = getIdCarrera();

        if (!idCarrera) {
            alert("Seleccioná una carrera primero.");
            return;
        }

        const correlativas = card.dataset.correlativas
            ? card.dataset.correlativas.split(",").map(Number).filter(n => n > 0)
            : [];

        const estaAprobada = aprobadas.has(parseInt(idMateria));
        const estaDesbloqueada = correlativas.length === 0 ||
            correlativas.every(c => c < 31 ? aprobadas.size >= c : aprobadas.has(c));

        if (!estaAprobada && !estaDesbloqueada) return;

        try {
            const url = `/api/materias/${estaAprobada ? "desaprobar" : "aprobar"}?idMateria=${idMateria}&idCarrera=${idCarrera}`;
            const method = estaAprobada ? "DELETE" : "POST";
            const response = await fetch(url, { method });

            if (!response.ok) {
                const msg = await response.text();
                alert(msg || "Error al procesar la materia.");
                return;
            }

            if (estaAprobada) {
                aprobadas.delete(parseInt(idMateria));
            } else {
                aprobadas.add(parseInt(idMateria));
            }

            recalcularEstados();

        } catch {
            alert("Error de conexión.");
        }
    }

    function recalcularEstados() {
        document.querySelectorAll(".materia").forEach(card => {
            const id = parseInt(card.dataset.id);
            const correlativas = card.dataset.correlativas
                ? card.dataset.correlativas.split(",").map(Number).filter(n => n > 0)
                : [];

            card.classList.remove("aprobada", "disponible", "bloqueada");

            if (aprobadas.has(id)) {
                card.classList.add("aprobada");
            } else if (
                correlativas.length === 0 ||
                correlativas.every(c => c < 31 ? aprobadas.size >= c : aprobadas.has(c))
            ) {
                card.classList.add("disponible");
            } else {
                card.classList.add("bloqueada");
            }
        });
    }

    function seleccionarCarrera(id, slug) {
        fetch(`/api/usuario-carrera/${id}`, { method: "POST" })
            .then(r => {
                setTimeout(() => window.location.href = `/planes/${slug}`, 800);
            })
            .catch(() => {
                document.getElementById("mensajeCarrera").innerHTML = "Error al conectar.";
            });
    }

    recalcularEstados();
</script>
