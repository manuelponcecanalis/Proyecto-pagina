@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@* Por vista: ViewData["UseHeaderEconomicas"] = true|false fuerza el header; si es null, usa FeatureFlags:UseHeaderEconomicas (appsettings / Development). *@
@{
    var useHeaderEconomicas = ViewData["UseHeaderEconomicas"] as bool?
        ?? Configuration.GetValue<bool>("FeatureFlags:UseHeaderEconomicas");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Proyecto Económicas - @ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    @if (useHeaderEconomicas)
    {
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;900&family=Roboto+Condensed:wght@700&family=Open+Sans:wght@400;600&family=Lato:wght@400;600&display=swap" rel="stylesheet" />
        <link rel="stylesheet" href="~/css/header-economicas.css" asp-append-version="true" />
    }
    @RenderSection("Styles", required: false)

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Q9Z8JBNK1C"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-Q9Z8JBNK1C');
    </script>

</head>

<body class="@(useHeaderEconomicas ? "site-header-econ-active" : null)">
    @if (useHeaderEconomicas)
    {
        <partial name="_HeaderEconomicas" />
    }
    else
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <img class="navbar-brand logoProyecto" src="~/images/logo.png" alt="Logo proyecto" />
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target="#navbarCollapseClassic"
                            aria-controls="navbarCollapseClassic"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div id="navbarCollapseClassic" class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">

                            <li class="nav-item">
                                <a class="nav-link text-dark @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                                   asp-controller="Home" asp-action="Index">
                                    Inicio
                                </a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark
                                    @(ViewContext.RouteData.Values["action"]?.ToString() == "RecomendacionesFCE"
                                          || ViewContext.RouteData.Values["action"]?.ToString() == "BiblioEconomicas"
                                          || ViewContext.RouteData.Values["action"]?.ToString() == "Cronograma"
                                          || ViewContext.RouteData.Values["action"]?.ToString() == "Ranking"
                                          ? "active" : "")"
                                   href="#"
                                   id="herramientasDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Herramientas
                                </a>

                                <ul class="dropdown-menu" aria-labelledby="herramientasDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="RecomendacionesFCE">
                                            Recomendaciones FCE
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="BiblioEconomicas">
                                            Biblio Economicas
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Materias" asp-action="Cronograma">
                                            Planes de Estudio
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="Ranking">
                                            Ranking
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="https://www.proyectofinanzas.com.ar/" target="_blank" rel="noopener noreferrer">
                                            Proyecto Finanzas
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark @(ViewContext.RouteData.Values["action"]?.ToString() == "Noticias" ? "active" : "")"
                                   asp-controller="Home" asp-action="Noticias">
                                    Anuncios
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark @(ViewContext.RouteData.Values["action"]?.ToString() == "CBC" ? "active" : "")"
                                   asp-controller="Home" asp-action="CBC">
                                    CBC
                                </a>
                            </li>

                            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Operador"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark
                                       @(ViewContext.RouteData.Values["controller"]?.ToString() == "CargaNoticias"
                                                                      || ViewContext.RouteData.Values["controller"]?.ToString() == "CargaCalendario"
                                                                      || ViewContext.RouteData.Values["controller"]?.ToString() == "MateriasDrive"
                                                                      ? "active" : "")"
                                       href="#"
                                       id="backendDropdown"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                        <b>BackEnd</b>
                                    </a>

                                    <ul class="dropdown-menu" aria-labelledby="backendDropdown">
                                        <li>
                                            <a class="dropdown-item" asp-controller="CargaNoticias" asp-action="Index">
                                                Carga Noticias
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="CargaCalendario" asp-action="Index">
                                                Eventos
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="MateriasDrive" asp-action="Index">
                                                BiblioEconomicas
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                        </ul>

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="@(useHeaderEconomicas ? "site-main-econ" : "container")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-links">
                    <a href="https://chat.whatsapp.com/Lt65YC6x3W89HDCs3vcYRy"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="footer-link"
                       data-red="whatsapp"
                       aria-label="Contacto por WhatsApp"
                       title="Contacto por WhatsApp">
                        <span class="footer-link__icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                        </span>
                    </a>

                    <a href="https://www.instagram.com/proyectoeconomicas/"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="footer-link"
                       data-red="instagram"
                       aria-label="Instagram — Proyecto Económicas"
                       title="Instagram">
                        <span class="footer-link__icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.382-2.618 6.98-6.98.058-1.28.072-1.689.072-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.98-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                        </span>
                    </a>

                    <a href="https://x.com/proyectofce?s=21"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="footer-link"
                       data-red="twitter"
                       aria-label="X (Twitter) — Proyecto Económicas"
                       title="X">
                        <span class="footer-link__icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        </span>
                    </a>

                    <a href="https://www.youtube.com/proyectoeconomicas"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="footer-link"
                       data-red="youtube"
                       aria-label="YouTube — Proyecto Económicas"
                       title="YouTube">
                        <span class="footer-link__icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                        </span>
                    </a>
                </div>
                <p class="footer-text">© 2024 PROYECTO Económicas. Todos los derechos reservados.</p>
            </div>
        </div>
        <div class="footer-bar"></div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (useHeaderEconomicas)
    {
        <script src="~/js/header-layout.js" asp-append-version="true"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
