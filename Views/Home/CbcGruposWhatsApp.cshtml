@{
    ViewData["Title"] = "Grupos de WhatsApp - CBC";
}

@section Styles {
    <link rel="stylesheet" href="~/css/academicas-landing.css" asp-append-version="true" />
}

<section class="academicas-hero">
    <div class="container">
        <h1>Grupos de WhatsApp</h1>
        <p>Canal del proyecto para dudas, avisos y acompañamiento en la cursada.</p>
    </div>
</section>

<section class="academicas-section">
    <div class="container">
        <div class="academicas-card text-center" style="max-width: 640px; margin: 0 auto;">
            <h2 class="h4">Sumate al grupo</h2>
            <p class="academicas-text">
                Entrá al grupo oficial de PROYECTO Económicas para coordinar con otras personas que cursan, enterarte de novedades y pedir ayuda.
            </p>
            <a class="btn btn-lg mt-2"
               style="background-color: #25d366; color: #fff; font-weight: 600;"
               href="https://chat.whatsapp.com/Lt65YC6x3W89HDCs3vcYRy"
               target="_blank"
               rel="noopener noreferrer">
                Abrir en WhatsApp
            </a>
        </div>
    </div>
</section>

<section class="academicas-section">
    <div class="container text-center">
        <p class="academicas-text mb-0">
            <a class="academicas-link" asp-controller="Home" asp-action="CBC">← Volver a la Guía CBC</a>
        </p>
    </div>
</section>
