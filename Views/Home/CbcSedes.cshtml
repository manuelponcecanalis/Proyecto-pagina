@{
    ViewData["Title"] = "Sedes CBC";
}

@section Styles {
    <link rel="stylesheet" href="~/css/academicas-landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/CBC.css" asp-append-version="true" />
}

<section class="academicas-hero">
    <div class="container">
        <h1>Sedes del CBC</h1>
        <p>Información de contacto y ubicación de cada sede. Verificá horarios y disponibilidad de materias en el SIU Guaraní antes de inscribirte.</p>
    </div>
</section>

<section class="academicas-section">
    <div class="container">
        <div class="cbc-sedes-grid">

            <div class="cbc-sede-card">
                <div class="cbc-sede-header">
                    <span class="cbc-sede-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                    </span>
                    <h2>Ciudad Universitaria</h2>
                </div>
                <div class="cbc-sede-body">
                    <p class="cbc-sede-detail">
                        <span class="cbc-sede-label">Dirección</span>
                        Pabellón III, Av. Intendente Güiraldes 2160, C1428EGA, CABA
                    </p>
                    <p class="cbc-sede-detail">
                        <span class="cbc-sede-label">Email</span>
                        <a class="academicas-link" href="mailto:ciudaduniversitaria@cbc.uba.ar">ciudaduniversitaria@cbc.uba.ar</a>
                    </p>
                    <a class="cbc-sede-map-link"
                       href="https://maps.google.com/?q=Av.+Intendente+Güiraldes+2160,+Ciudad+Universitaria,+CABA"
                       target="_blank" rel="noopener noreferrer">
                        Ver en Google Maps →
                    </a>
                </div>
            </div>

