@model Pagina_proyecto.Models.ViewModels.HomeIndexViewModel

@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Index.css" asp-append-version="true" />
}

<!-- ================= CARRUSEL ================= -->
<div class="carousel-container">
    <div class="carousel-item">
        <img id="carousel-imagen" src="">
        <div class="carousel-caption">
            <h2 id="carousel-title"></h2>
            <p id="carousel-body"></p>
        </div>
    </div>
    <button class="carousel-button left" onclick="moveCarousel(-1)">&#10094;</button>
    <button class="carousel-button right" onclick="moveCarousel(1)">&#10095;</button>
</div>

<!-- ================= CONTENEDOR PRINCIPAL ================= -->
<div class="main-content">

    <!-- ================= CALENDARIO ================= -->
   
    <!-- ================= CARDS ================= -->
    <div class="cards-container">

        <div class="card planEstudio" onclick="abrirModalPlanes()">
            <img src="~/PlanesDeEstudio/Economía.jpg" />
            <h3>Planes de estudio</h3>
            <p>
                Explorá los planes de estudio actualizados de todas las carreras
            </p>
        </div>

        <div class="card gruposWsp" onclick="abrirModalGruposWsp()">
            <img src="~/logos/CapturaGruposWsp.png" />
            <h3>Grupos de wsp por curso</h3>
            <p>Encontrá tu grupo de cursada o crealo y subilo para que otros se sumen</p>
        </div>

        <a href="@Url.Action("Ranking", "Home")">
            <div class="card">
                <img src="~/tutorialRanking.jpeg" />
                <h3>Calculá tu ranking actual</h3>
                <p>Calculá tu ranking y planificá bien tu inscripción!</p>
            </div>
        </a>

        <a href="@Url.Action("RecomendacionesFCE", "Home")">
            <div class="card">
                <img src="~/logos/capturaRecomendaciones.png" />
                <h3>Recomendaciones FCE</h3>
                <p>Más de 10.000 recomendaciones de cursos hechas por estudiantes</p>
            </div>
        </a>

        <a href="@Url.Action("BiblioEconomicas", "Home")">
            <div class="card">
                <img src="~/logos/CapturaBiblio.png" />
                <h3>Biblio Económicas</h3>
                <p>Encontrá bibliografía, apuntes y modelos de tus materias</p>
            </div>
        </a>

    </div>
</div>
<div class="widgetCalendario">
    <h3>Calendario Académico</h3>

    <div class="eventsCalendario">
        @{
            var proximosEventos = Model.EventosCalendario
            
            .Take(3)
            .ToList();
        }

        @foreach (var evento in proximosEventos)
        {
            <div class="eventCalendario evento-expandible"
                 data-titulo="@evento.Titulo"
                 data-cuerpo="@evento.Cuerpo">

                <div class="detailsCalendario">
                    <span class="timeCalendario">
                        @evento.FechaInicio
                        @if (!string.IsNullOrEmpty(evento.FechaFin) && evento.FechaFin != evento.FechaInicio)
                        {
                            <text> al @evento.FechaFin</text>
                        }
                    </span>

                    <p>@evento.Titulo</p>
                    <div class="eventoCuerpoExpandido"></div>
                </div>
            </div>
        }
    </div>

    <div class="footerCalendario">
        <span onclick="abrirModalCalendario2026()">
            Calendario completo 2026
        </span>
    </div>
</div>

<!-- ================= MODAL PLANES ================= -->
<div id="modalPlanes" class="modal" onclick="cerrarModalDesdeFondo(event)">
    <div class="modal-content">
        <span class="close" onclick="cerrarModal()">&times;</span>
        <div id="contenedorPlanes"></div>
    </div>
</div>

<!-- ================= MODAL CALENDARIO ================= -->
<div id="modalCalendario2026" class="modal" onclick="cerrarModalCalendario(event)">
    <div class="modal-content">
        <span class="close" onclick="cerrarModalCalendario()">&times;</span>
        <h2 style="text-align:center;">Calendario Académico 2026</h2>
        <div id="contenedorCalendario2026" class="eventsCalendario"></div>
    </div>
</div>

@section Scripts {
    <script>
        // ================= CARRUSEL =================
        let currentIndex = 0;
        const noticias = @Html.Raw(Json.Serialize(Model.Noticias.Take(3)));

        function gestionCarrusel() {
            const n = noticias[currentIndex];
            if (!n) return;

            document.getElementById('carousel-imagen').src = n.primeraImagenUrl;
            document.getElementById('carousel-title').innerText = n.titulo;
            document.getElementById('carousel-body').innerText = n.subtitulo;
            document.querySelector('.carousel-item').onclick = () => {
                window.location.href = `/Home/DetalleNoticia?id=${n.id}`;
            };
        }

        function moveCarousel(dir) {
            currentIndex = (currentIndex + dir + noticias.length) % noticias.length;
            gestionCarrusel();
        }

        gestionCarrusel();

        // ================= MODAL PLANES =================
        function abrirModalPlanes() {
            fetch('/Home/ObtenerPlanesDeEstudio')
                .then(r => r.json())
                .then(data => {
                    const c = document.getElementById('contenedorPlanes');
                    c.innerHTML = '';
                    data.forEach(i => {
                        const nombre = i.url.split('/').pop().replace('.jpg', '');
                        const pdf = `/PlanesDeEstudioPDF/${nombre}.pdf`;
                        c.innerHTML += `
                            <div class="planesDeEstudio" onclick="window.open('${pdf}')">
                                <img src="${i.url}">
                                <h3>${i.titulo}</h3>
                            </div>`;
                    });
                    document.getElementById('modalPlanes').style.display = 'flex';
                });
        }

               function abrirModalGruposWsp() {
            document.getElementById('contenedorPlanes').innerHTML = `
                <div class="gruposWSP"
                     onclick="window.open('https://docs.google.com/spreadsheets/d/1mz_13bcCP8fOqGfdUz70RBQJyo47P-D0/edit?usp=drivesdk&ouid=118121082394623422809&rtpof=true&sd=true', '_blank')">
                    <img src="/logos/CapturaGruposWsp.png">
                    <h3>Grupos de WSP por curso</h3>
                </div>
            `;
            document.getElementById('modalPlanes').style.display = 'flex';
        }


        function cerrarModal() {
            document.getElementById('modalPlanes').style.display = 'none';
        }

        function cerrarModalDesdeFondo(e) {
            if (!e.target.closest('.modal-content')) cerrarModal();
        }

        // ================= MODAL CALENDARIO =================
               function abrirModalCalendario2026() {
            const contenedor = document.getElementById('contenedorCalendario2026');
            contenedor.innerHTML = '';

            const eventos = @Html.Raw(Json.Serialize(Model.EventosCalendario));

            eventos.forEach(evento => {
                const div = document.createElement('div');
                div.classList.add('eventCalendario', 'evento-expandible');

                div.dataset.cuerpo = evento.cuerpo ?? '';

                div.innerHTML = `
                    <div class="detailsCalendario">
                        <span class="timeCalendario">
                            ${evento.fechaInicio ?? ''}
                            ${evento.fechaFin && evento.fechaFin !== evento.fechaInicio ? ' al ' + evento.fechaFin : ''}
                        </span>

                        <p>${evento.titulo ?? ''}</p>

                        <div class="eventoCuerpoExpandido"></div>
                    </div>
                `;

                contenedor.appendChild(div);
            });

            document.getElementById('modalCalendario2026').style.display = 'flex';
        }

        function cerrarModalCalendario(e) {
            if (!e || !e.target.closest('.modal-content')) {
                document.getElementById('modalCalendario2026').style.display = 'none';
            }
        }

        // ================= EVENTOS EXPANDIBLES =================
        document.addEventListener('click', e => {
            const evento = e.target.closest('.evento-expandible');
            if (!evento) return;

            const cuerpo = evento.dataset.cuerpo;
            if (!cuerpo) return;

            const cont = evento.querySelector('.eventoCuerpoExpandido');

            evento.classList.toggle('activo');
            cont.innerHTML = evento.classList.contains('activo') ? cuerpo : '';
        });
    </script>
}
