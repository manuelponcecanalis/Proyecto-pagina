@{
    ViewData["Title"] = "Calendario académico";
}
@section Styles {
    <link rel="stylesheet" href="~/css/academicas-landing.css" asp-append-version="true" />
}

<section class="academicas-hero">
    <div class="container">
        <h1>📘 Calendario Académico</h1>
        <p>Fechas clave de cursadas, exámenes e inscripciones. Guardalo para no colgarte.</p>
    </div>
</section>

<section class="academicas-section">
    <div class="container">
        <div class="academicas-card">
            <h2>Exámenes libres y remanentes</h2>
            <div class="academicas-table-wrap">
                <table class="academicas-table">
                    <thead>
                        <tr>
                            <th>Turno</th>
                            <th>Inscripción</th>
                            <th>Fechas de examen</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>Marzo</td><td>24 y 25 de febrero</td><td>16 al 20 de marzo</td></tr>
                        <tr><td>Mayo</td><td>28 y 29 de abril</td><td>18 al 22 de mayo</td></tr>
                        <tr><td>Agosto</td><td>28 y 29 de julio</td><td>24 al 28 de agosto</td></tr>
                        <tr><td>Octubre</td><td>29 y 30 de septiembre</td><td>19 al 23 de octubre</td></tr>
                        <tr><td>Diciembre</td><td>10 y 11 de noviembre</td><td>30 nov al 4 dic</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<section class="academicas-section">
    <div class="container">
        <div class="academicas-card">
            <h2>Cursos – primer cuatrimestre</h2>
            <div class="academicas-table-wrap">
                <table class="academicas-table">
                    <thead>
                        <tr><th>Etapa</th><th>Fechas</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Inscripción (todas las modalidades)</td><td>12 al 18 de febrero</td></tr>
                        <tr><td>Publicación resultados</td><td>26 de febrero</td></tr>
                        <tr><td>Vacantes presencial</td><td>27 feb al 2 mar</td></tr>
                        <tr><td>Publicación resultados</td><td>6 de marzo</td></tr>
                        <tr><td>Dictado presencial</td><td>12 de marzo al 4 de julio</td></tr>
                        <tr><td>Vacantes distancia/magistral/virtual</td><td>9 y 10 de marzo</td></tr>
                        <tr><td>Publicación resultados</td><td>13 de marzo</td></tr>
                        <tr><td>Dictado distancia/magistral/virtual</td><td>17 de marzo al 4 de julio</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<section class="academicas-section">
    <div class="container">
        <div class="academicas-card">
            <h2>Intensivo de invierno</h2>
            <div class="academicas-table-wrap">
                <table class="academicas-table">
                    <thead>
                        <tr><th>Etapa</th><th>Fechas</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Inscripción</td><td>30 de junio al 1 de julio</td></tr>
                        <tr><td>Publicación resultados</td><td>3 de julio</td></tr>
                        <tr><td>Dictado de clases</td><td>6 de julio al 7 de agosto</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<section class="academicas-section">
    <div class="container">
        <div class="academicas-card">
            <h2>Segundo cuatrimestre</h2>
            <div class="academicas-table-wrap">
                <table class="academicas-table">
                    <thead>
                        <tr><th>Etapa</th><th>Fechas</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Inscripción (todas las modalidades)</td><td>16 al 21 de julio</td></tr>
                        <tr><td>Publicación resultados</td><td>30 de julio</td></tr>
                        <tr><td>Vacantes presencial</td><td>31 jul al 3 ago</td></tr>
                        <tr><td>Publicación resultados</td><td>7 de agosto</td></tr>
                        <tr><td>Dictado presencial</td><td>13 de agosto al 4 de septiembre</td></tr>
                        <tr><td>Vacantes distancia/magistral/virtual</td><td>10 y 11 de agosto</td></tr>
                        <tr><td>Publicación resultados</td><td>14 de agosto</td></tr>
                        <tr><td>Dictado distancia/magistral/virtual</td><td>18 de agosto al 4 de diciembre</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<section class="academicas-section">
    <div class="container">
        <div class="academicas-card">
            <h2>Intensivo de verano</h2>
            <div class="academicas-table-wrap">
                <table class="academicas-table">
                    <thead>
                        <tr><th>Etapa</th><th>Fechas</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Inscripción</td><td>1 y 2 de diciembre</td></tr>
                        <tr><td>Publicación resultados</td><td>11 de diciembre</td></tr>
                        <tr><td>Dictado distancia/magistral/virtual</td><td>14 dic 2026 al 9 mar 2027</td></tr>
                        <tr><td>Dictado intensivo</td><td>1 feb al 9 mar 2027</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<section class="academicas-section pb-5">
    <div class="container">
        <div class="academicas-card">
            <h2>Declaraciones juradas</h2>
            <p class="academicas-subheading">Primer cuatrimestre (solo días hábiles)</p>
            <ul class="academicas-list-plain">
                <li>15 al 18 de diciembre 2025</li>
                <li>4 al 9 de febrero 2026</li>
                <li>19 al 23 de febrero 2026</li>
                <li>3 al 5 de marzo 2026</li>
            </ul>
            <p class="academicas-subheading">Segundo cuatrimestre (solo días hábiles)</p>
            <ul class="academicas-list-plain">
                <li>8 al 13 de julio 2026</li>
                <li>22 al 27 de julio 2026</li>
                <li>4 al 6 de agosto 2026</li>
            </ul>
        </div>
        <p class="text-muted small mt-4 mb-0">Verificá siempre fechas y resoluciones vigentes en la <a href="https://www.econ.uba.ar/" target="_blank" rel="noopener noreferrer">web oficial de la FCE UBA</a> y en MiEcon.</p>
    </div>
</section>
