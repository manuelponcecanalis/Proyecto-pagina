
@{
    ViewData["Title"] = "Conocenos";
}

@section Styles {

    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
}
<div class="contenedorConocenos1">
    <div class="quienSomosDescripcion">
        <h1>¿Quiénes somos? </h1>
        <p>
            Proyecto es una agrupación de estudiantes como vos, que desde el 2019 venimos pensando de qué manera mejorar nuestra facultad. Para eso, hacemos clases de apoyo, talleres de herramientas informáticas, charlas de coyuntura económica, reuniones abiertas para debatir sobre nuestros planes de estudios y muchas más actividades que creemos necesarias para mejorar tanto nuestra formación académica como nuestro paso por la facultad.
        </p>
        <img src="~/foto_grupal_proyecto.jpg" alt="Proyecto crew" />
    </div>
    <div class="FinanzasYRedes">
        <div class="Finanzas"></div> 
        <div class="RedesSociales">
            <div>
                <h1>Redes</h1>
            </div>
            <div>
                <div>
                    <img src="~/instagram.png" alt="logo instagram" class="igImg" />
                </div>
                <div>
                    <img src="~/youtube.png" alt="logoYouTube" class="youtubeImg" />
                </div>
                
            </div>
        </div>
    </div>
    <div class="quienSomosDescripcion">
        <h1>¿Quiénes somos? </h1>
        <p>
            Proyecto es una agrupación de estudiantes como vos, que desde el 2019 venimos pensando de qué manera mejorar nuestra facultad. Para eso, hacemos clases de apoyo, talleres de herramientas informáticas, charlas de coyuntura económica, reuniones abiertas para debatir sobre nuestros planes de estudios y muchas más actividades que creemos necesarias para mejorar tanto nuestra formación académica como nuestro paso por la facultad.
        </p>
        <img src="~/foto_grupal_proyecto.jpg" alt="Proyecto crew" />
    </div>
</div>


